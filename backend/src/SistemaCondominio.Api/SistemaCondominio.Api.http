@host = http://localhost:5234
@qrCodeId = 99a6b41c-8bc0-47b6-bbbc-63e40e75b8ec
@localId = 02f19833-cdfa-4c5d-8279-b35e16c7fa26

### Consulta anônima por QR Code (moradores)
GET {{host}}/api/qrcode/{{qrCodeId}}
Accept: application/json

###
# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "zelador@flores.com.br",
  "senha": "Dev@12345"
}

###
@token = {{login.response.body.token}}

GET {{host}}/api/locais
Authorization: Bearer {{token}}

###
GET {{host}}/api/servicos/por-local/{{localId}}?pagina=1&tamanho=20
Authorization: Bearer {{token}}

###
POST {{host}}/api/servicos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "localId": "{{localId}}",
  "tipo": "limpeza",
  "descricao": "Limpeza da tarde",
  "responsavel": "Zelador Flores"
}
